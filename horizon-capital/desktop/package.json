{
  "name": "horizon-capital-desktop",
  "version": "0.1.0",
  "description": "Horizon Capital — AI Hedge Fund Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.horizoncapital.desktop",
    "productName": "Horizon Capital",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../backend-dist/",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/dist/",
        "to": "frontend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icons/icon.ico"
    }
  }
}
