{
  "name": "horizon-capital-desktop",
  "version": "0.2.0",
  "description": "Horizon Capital \u2014 AI Hedge Fund Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icon": "python ../desktop/make_icon.py",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.horizoncapital.desktop",
    "productName": "Horizon Capital",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "backend.js",
      "preload.js",
      "tray.js",
      "splash.html",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend-dist/",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/*.db",
          "!**/*.db-*",
          "!**/*.sqlite*",
          "!**/*.log",
          "!**/.git/**"
        ]
      },
      {
        "from": "../frontend/dist/",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/*.db",
          "!**/*.db-*",
          "!**/*.sqlite*",
          "!**/*.log",
          "!**/.git/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "icon": "icons/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icons/icon.ico",
      "shortcutName": "Horizon Capital",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallerIcon": "icons/icon.ico",
      "artifactName": "HorizonCapital-Setup.${ext}"
    }
  },
  "author": "Aaryan Baadkar <aaryanbaadkar71@gmail.com>",
  "contributors": [
    "Aaryan Baadkar <aaryanbaadkar71@gmail.com>"
  ]
}
