{
  "name": "horizon-capital-desktop",
  "version": "0.2.0",
  "description": "Horizon Capital — AI Hedge Fund Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icon": "python ../desktop/make_icon.py",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.horizoncapital.desktop",
    "productName": "Horizon Capital",
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "backend.js", "preload.js", "tray.js", "splash.html", "icons/**/*"],
    "extraResources": [
      {
        "from": "../backend-dist/",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/dist/",
        "to": "frontend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "icon": "icons/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icons/icon.ico",
      "shortcutName": "Horizon Capital"
    }
  }
}
