# ============================================
# Horizon Capital - Environment Configuration
# ============================================
# Copy to .env and fill in values

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=horizon
POSTGRES_USER=horizon
POSTGRES_PASSWORD=changeme_in_production

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=changeme_generate_a_random_32_byte_hex
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- JWT Auth ---
JWT_SECRET_KEY=changeme_generate_a_random_32_byte_hex
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Default CIO Credentials ---
CIO_DEFAULT_USERNAME=admin
CIO_DEFAULT_PASSWORD=changeme

# --- Broker: Zerodha Kite ---
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_MOCK_MODE=true

# --- Broker: Alpaca ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_MODE=true

# --- Data: Polygon.io ---
POLYGON_API_KEY=

# --- Data: NewsAPI ---
NEWSAPI_API_KEY=

# --- Data: Reddit (PRAW) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=horizon-capital:v1.0

# --- LLM: Claude API (Debate Engine) ---
ANTHROPIC_API_KEY=

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=

# --- System Mode ---
# PAPER_TRADING | HUMAN_APPROVAL | FULLY_AUTONOMOUS
SYSTEM_MODE=PAPER_TRADING

# --- Risk Defaults ---
RISK_MAX_DRAWDOWN_PCT=10.0
RISK_MAX_POSITION_PCT=5.0
RISK_MAX_LEVERAGE=1.0
RISK_VAR_LIMIT_PCT=3.0

# --- Trading Universe ---
INDIA_SYMBOLS=RELIANCE.NSE,TCS.NSE,INFY.NSE,HDFCBANK.NSE,ICICIBANK.NSE
US_SYMBOLS=AAPL.NASDAQ,MSFT.NASDAQ,GOOGL.NASDAQ,AMZN.NASDAQ,TSLA.NASDAQ
CRYPTO_SYMBOLS=BTC-USD,ETH-USD
