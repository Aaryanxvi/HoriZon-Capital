# ============================================
# Horizon Capital - Environment Configuration
# ============================================
# Copy to backend/.env and fill in values.
# Secrets (APP_SECRET_KEY, JWT_SECRET_KEY, CIO_DEFAULT_PASSWORD,
# POSTGRES_PASSWORD) are auto-generated if left blank.

# --- Storage Backend ---
# LOCAL = SQLite + in-memory bus (zero infrastructure)
# POSTGRES = PostgreSQL + Redis (production)
STORAGE_BACKEND=LOCAL

# --- Database (only needed for POSTGRES backend) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=horizon
POSTGRES_USER=horizon
# Leave blank to auto-generate a secure random password
POSTGRES_PASSWORD=

# --- Redis (only needed for POSTGRES backend) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Application ---
APP_ENV=development
# Leave blank to auto-generate a secure random key
APP_SECRET_KEY=
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- JWT Auth ---
# Leave blank to auto-generate a secure random key
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Default CIO Credentials ---
CIO_DEFAULT_USERNAME=admin
# Leave blank to auto-generate a secure random password
CIO_DEFAULT_PASSWORD=

# --- Broker: Zerodha Kite ---
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_MOCK_MODE=true

# --- Broker: Alpaca ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_MODE=true

# --- Data: Polygon.io ---
POLYGON_API_KEY=

# --- Data: NewsAPI ---
NEWSAPI_API_KEY=

# --- Data: Reddit (PRAW) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=horizon-capital:v1.0

# --- LLM Providers (at least one recommended for AI debates) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Department AI Routing ---
# Values: "auto" (any available), "claude", "openai", "gemini", "none"
AI_FRONT_OFFICE=auto
AI_MIDDLE_OFFICE=auto
AI_BACK_OFFICE=auto
AI_EXECUTIVE=auto

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=

# --- System Mode ---
# PAPER_TRADING | HUMAN_APPROVAL | FULLY_AUTONOMOUS
SYSTEM_MODE=PAPER_TRADING

# --- CIO Mode ---
# HUMAN | AI
CIO_MODE=HUMAN

# --- Initial Capital ---
INITIAL_CAPITAL_USD=1000000
INITIAL_CAPITAL_INR=10000000

# --- LLM Rate Limits ---
# Max LLM API calls per minute (across all providers)
LLM_MAX_CALLS_PER_MINUTE=60

# --- Risk Defaults ---
RISK_MAX_DRAWDOWN_PCT=10.0
RISK_MAX_POSITION_PCT=5.0
RISK_MAX_LEVERAGE=1.0
RISK_VAR_LIMIT_PCT=3.0
RISK_DAILY_LOSS_LIMIT_PCT=5.0
RISK_MAX_ORDERS_PER_MINUTE=10
RISK_FREE_RATE=0.0  # Annualised risk-free rate for Sharpe/Sortino (single source of truth)

# --- Trading Universe ---
INDIA_SYMBOLS=RELIANCE.NSE,TCS.NSE,INFY.NSE,HDFCBANK.NSE,ICICIBANK.NSE
US_SYMBOLS=AAPL.NASDAQ,MSFT.NASDAQ,GOOGL.NASDAQ,AMZN.NASDAQ,TSLA.NASDAQ
CRYPTO_SYMBOLS=BTC-USD,ETH-USD
